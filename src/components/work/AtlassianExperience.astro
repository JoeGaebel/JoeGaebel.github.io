---
import {Image} from "astro:assets"
import WorkExperience from "./WorkExperience.astro"
import atlassian from "../../assets/logos/atlassian.png"
import {tenureYears, ATLASSIAN_START} from "../../utils/tenure"

const principles = ["Extreme Programming", "Lean Software Engineering", "Lean Product Management", "Test-First Programming", "Pair Programming", "Continuous Integration", "Continuous Deployment & Delivery"]
const technologies = ["Spring Boot", "Google Guice", "AWS SQS", "PostgreSQL", "Bitbucket Pipelines"]
const testingTech = ["JUnit 5", "Mockito"]

// Tenure at Atlassian, in 0.5 year increments (rounded to nearest) from the May
// 2023 start date. Rendered at build time, then recalculated on the client (see
// script below) so it stays current without needing a redeploy.
const years = tenureYears(ATLASSIAN_START.year, ATLASSIAN_START.monthIndex)
---
<WorkExperience
    companyName="Atlassian"
    city="Sydney, Australia"
    titles={["Senior Software Engineer"]}
    dateString={["May 2023 to present"]}
    years={years}
    yearsId="atlassian-tenure"
    imageContainerMarginRight="-1.5rem"
>
    <Image slot="image" style="width: 68px; margin-top: -0.7rem; margin-right: 2rem; margin-bottom: 1rem; margin-left: 0rem" src={atlassian} alt="Atlassian logo" width={136} height={136} />
    <Fragment slot="description">
        <div class="mb-[0.8rem]">I spent two years on a Jira platform team <b>delivering significant improvements to performance, scale, and cost efficiency.</b></div>
        <div class="mb-[0.8rem]">Currently, I'm helping to provide a centralised messaging system for all messages across products at Atlassian.</div>
        <div class="mb-[0.8rem]">Additionally, I <b>help improve ways of working and engineering practices</b>.</div>
        <div class="mt-6">The practices I help instil are:</div>
        <div class="mb-3">{principles.map(k => <span class="tag tag-success mr-1 mt-1 text-[1rem]">{k}</span>)}</div>
        <div class="mt-6">The technologies I use most are:</div>
        <div class="mb-3">{technologies.map(k => <span class="tag tag-info mr-1 mt-1 text-[1rem]">{k}</span>)}</div>
        <div class="mt-6">I test drive with:</div>
        <div class="mb-3">{testingTech.map(k => <span class="tag tag-success-light mr-1 mt-1 text-[1rem]">{k}</span>)}</div>
    </Fragment>
</WorkExperience>
<script>
    import {tenureYears, ATLASSIAN_START} from "../../utils/tenure"

    // Recalculate tenure in the browser so it reflects the current date rather
    // than the build date — keeps "X yrs" fresh without a redeploy.
    const el = document.getElementById("atlassian-tenure")
    if (el) el.textContent = tenureYears(ATLASSIAN_START.year, ATLASSIAN_START.monthIndex)
</script>
